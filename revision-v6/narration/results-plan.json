  "shots": [
    {"id": "final-footage", "start": 0, "duration": 10,
      "meaning": "The recording shows final assembly; I estimated one metre for the test with the finished design.",
      "speech": "\u0045\u006e \u0065\u0073\u0074\u0061 \u0067\u0072\u0061\u0062\u0061\u0063\u0069\u00f3\u006e \u0073\u0065 \u0076\u0065 \u0065\u006c \u006d\u006f\u006e\u0074\u0061\u006a\u0065 \u0066\u0069\u006e\u0061\u006c. \u0050\u0061\u0072\u0061 \u006c\u0061 \u0070\u0072\u0075\u0065\u0062\u0061 \u0063\u006f\u006e \u0065\u006c \u0064\u0069\u0073\u0065\u00f1\u006f \u0074\u0065\u0072\u006d\u0069\u006e\u0061\u0064\u006f \u0063\u0061\u006c\u0063\u0075\u006c\u00e9 \u0075\u006e\u0061 \u0061\u006c\u0074\u0075\u0072\u0061 \u0061\u0070\u0072\u006f\u0078\u0069\u006d\u0061\u0064\u0061 \u0064\u0065 \u0075\u006e \u006d\u0065\u0074\u0072\u006f."},
    {"id": "results-chart", "start": 10, "duration": 16,
      "meaning": "My goal was at least five metres. The three versions reached approximately two, half a metre, and one metre.",
      "speech": "\u004d\u0069 \u006d\u0065\u0074\u0061 \u0065\u0072\u0061 \u006c\u006c\u0065\u0067\u0061\u0072 \u0061\u006c \u006d\u0065\u006e\u006f\u0073 \u0061 \u0063\u0069\u006e\u0063\u006f \u006d\u0065\u0074\u0072\u006f\u0073. \u004c\u0061 \u0070\u0072\u0069\u006d\u0065\u0072\u0061 \u0076\u0065\u0072\u0073\u0069\u00f3\u006e \u006c\u006c\u0065\u0067\u00f3 \u0061 \u0064\u006f\u0073, \u006c\u0061 \u0062\u006f\u0074\u0065\u006c\u006c\u0061 \u006d\u00e1\u0073 \u0067\u0072\u0061\u006e\u0064\u0065 \u0061 \u006d\u0065\u0064\u0069\u006f \u006d\u0065\u0074\u0072\u006f \u0079 \u0065\u006c \u0064\u0069\u0073\u0065\u00f1\u006f \u0066\u0069\u006e\u0061\u006c \u0061 \u0075\u006e\u006f. \u0053\u006f\u006e \u0065\u0073\u0074\u0069\u006d\u0061\u0063\u0069\u006f\u006e\u0065\u0073."},
    {"id": "results-bottle", "start": 26, "duration": 16,
      "meaning": "A larger bottle does not guarantee height. More mass needs more thrust; equal added gas in more free space could produce a smaller pressure increase.",
      "speech": "\u0055\u006e\u0061 \u0062\u006f\u0074\u0065\u006c\u006c\u0061 \u006d\u00e1\u0073 \u0067\u0072\u0061\u006e\u0064\u0065 \u006e\u006f \u0067\u0061\u0072\u0061\u006e\u0074\u0069\u007a\u0061 \u006d\u00e1\u0073 \u0061\u006c\u0074\u0075\u0072\u0061. \u0053\u0069 \u0070\u0065\u0073\u0061\u0062\u0061 \u006d\u00e1\u0073, \u006e\u0065\u0063\u0065\u0073\u0069\u0074\u0061\u0062\u0061 \u006d\u00e1\u0073 \u0065\u006d\u0070\u0075\u006a\u0065. \u0059 \u0063\u006f\u006e \u0065\u006c \u006d\u0069\u0073\u006d\u006f \u0067\u0061\u0073 \u0065\u006e \u006d\u00e1\u0073 \u0065\u0073\u0070\u0061\u0063\u0069\u006f, \u0065\u006c \u0061\u0075\u006d\u0065\u006e\u0074\u006f \u0064\u0065 \u0070\u0072\u0065\u0073\u0069\u00f3\u006e \u0070\u006f\u0064\u00ed\u0061 \u0073\u0065\u0072 \u006d\u0065\u006e\u006f\u0072."},
    {"id": "results-design", "start": 42, "duration": 16,
      "meaning": "Fins aid direction but add mass and drag. Leaks, tilt or support friction could also have limited flight; these are hypotheses.",
      "speech": "\u004c\u0061\u0073 \u0061\u006c\u0065\u0074\u0061\u0073 \u0061\u0079\u0075\u0064\u0061\u006e \u0061 \u006d\u0061\u006e\u0074\u0065\u006e\u0065\u0072 \u006c\u0061 \u0064\u0069\u0072\u0065\u0063\u0063\u0069\u00f3\u006e, \u0070\u0065\u0072\u006f \u0074\u0061\u006d\u0062\u0069\u00e9\u006e \u0061\u00f1\u0061\u0064\u0065\u006e \u0070\u0065\u0073\u006f \u0079 \u0072\u0065\u0073\u0069\u0073\u0074\u0065\u006e\u0063\u0069\u0061. \u0041\u0064\u0065\u006d\u00e1\u0073, \u0075\u006e\u0061 \u0066\u0075\u0067\u0061, \u0075\u006e\u0061 \u0073\u0061\u006c\u0069\u0064\u0061 \u0069\u006e\u0063\u006c\u0069\u006e\u0061\u0064\u0061 \u006f \u0065\u006c \u0072\u006f\u0063\u0065 \u0063\u006f\u006e \u0065\u006c \u0073\u006f\u0070\u006f\u0072\u0074\u0065 \u0070\u0075\u0064\u0069\u0065\u0072\u006f\u006e \u006c\u0069\u006d\u0069\u0074\u0061\u0072 \u0065\u006c \u0076\u0075\u0065\u006c\u006f."},
    {"id": "results-limits", "start": 58, "duration": 12,
