{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "typeRoots": ["./.typecheck/node_modules/@types", "./node_modules/@types"],
    "lib": ["ES2020", "DOM"],
    "noEmit": true
  },
  "include": ["src"]
}
